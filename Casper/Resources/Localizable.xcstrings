      "comment" : "Status in Settings > Permissions when the app has been granted a permission, such as microphone or accessibility access."
    },
    "Always" : {
      "comment" : "Option in the Keep Microphone On setting: the microphone stays on the whole time Casper runs."
    },
    "Another persona is already named “%@”." : {
      "comment" : "Shown in the persona editor when the name entered is taken. The argument is the name."
    },
