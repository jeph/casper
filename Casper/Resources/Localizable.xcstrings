{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@, %lld-bit" : {
      "comment" : "A model's name, its size in parameters, such as 0.6B, and the precision of its weights in bits. For example, \"Qwen3-ASR 0.6B, 5-bit\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@, %3$lld-bit"
          }
        }
      }
    },
    "%@ (Not Connected)" : {
      "comment" : "Input device option for the chosen microphone while it's unplugged. The placeholder is the device name."
    },
    "%@ Copy" : {
      "comment" : "Name of a duplicated persona. The argument is the original's name."
    },
    "%@ of %@ words" : {
      "comment" : "Word count under a persona's instructions. The arguments are the count and the most allowed."
    },
    "1 Minute" : {
      "comment" : "Option in the Keep Microphone On setting: how long the microphone stays on after a dictation."
    },
    "10 Minutes" : {
      "comment" : "Option in the Keep Microphone On setting: how long the microphone stays on after a dictation."
    },
    "15 Minutes" : {
      "comment" : "Option in the Keep Microphone On setting: how long the microphone stays on after a dictation."
    },
    "5 Minutes" : {
      "comment" : "Option in the Keep Microphone On setting: how long the microphone stays on after a dictation."
    },
    "A bubble on screen that shows when Casper is listening. Drag it to move it." : {
      "comment" : "Description of the General setting that shows or hides the floating voice bubble."
    },
    "About Casper" : {
      "comment" : "Menu bar item that opens the About window."
