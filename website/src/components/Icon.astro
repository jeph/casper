---
const paths = {
  sparkles: [
    "M11 3.5 12.9 8.6 18 10.5 12.9 12.4 11 17.5 9.1 12.4 4 10.5 9.1 8.6Z",
    "M18.5 15 19.3 17.2 21.5 18 19.3 18.8 18.5 21 17.7 18.8 15.5 18 17.7 17.2Z",
  ],
  lock: ["M6.5 11h11a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-11a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2Z", "M8 11V8a4 4 0 0 1 8 0v3"],
  pen: ["M4 20l1-4.5L15.5 5a2.1 2.1 0 0 1 3 3L8 18.5Z", "M13.5 7l3 3"],
  book: ["M6 3.5h12v17H6.5a2.5 2.5 0 0 1-2.5-2.5V6a2.5 2.5 0 0 1 2-2.5Z", "M4 18a2.5 2.5 0 0 1 2.5-2.5H18", "M9 8h5"],
  clock: ["M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18Z", "M12 7.5V12l3 2"],
  zap: ["M13 2.5 4.5 13.5H11l-1 8 8.5-11H12Z"],
  cursor: ["M4 6h16", "M4 12h9", "M4 18h6", "M18 13v8", "M16 13h4M16 21h4"],
  chip: [
    "M8 6h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z",
    "M10 2.5V6M14 2.5V6M10 18v3.5M14 18v3.5M2.5 10H6M2.5 14H6M18 10h3.5M18 14h3.5",
  ],
  house: ["M4 11 12 4l8 7", "M6 9.5V20h12V9.5", "M10 20v-5h4v5"],
  download: ["M12 3.5v12", "M7 11l5 5 5-5", "M5 20.5h14"],
  copy: ["M9 9h10.5v11.5H9Z", "M15 9V4.5H4.5V15H9"],
  star: ["M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.9Z"],
  check: ["M5 12.5l4.5 4.5L19 7.5"],
  cross: ["M6.5 6.5l11 11M17.5 6.5l-11 11"],
  heart: [
    "M12 20.5s-7.8-4.6-9.2-9.6C1.8 7.3 4.2 4 7.4 4c2 0 3.5 1.2 4.6 2.8C13.1 5.2 14.6 4 16.6 4c3.2 0 5.6 3.3 4.6 6.9-1.4 5-9.2 9.6-9.2 9.6Z",
  ],
} as const

export type IconName = keyof typeof paths

interface Props {
  name: IconName
  class?: string
}

const { name, class: className } = Astro.props
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths[name].map((d) => (
    <path d={d} />
  ))}
</svg>

<style>
  .icon {
    width: 1.25em;
    height: 1.25em;
    flex: none;
  }
</style>
